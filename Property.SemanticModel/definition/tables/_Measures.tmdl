	measure 'Total Revenue PM' =
			
			VAR CurrentMonth = MAX(FinancialData[Month])
			VAR PreviousMonthStart = EOMONTH(CurrentMonth, -2) + 1
			VAR PreviousMonthEnd = EOMONTH(CurrentMonth, -1)
			RETURN
			CALCULATE(
			    [Total Revenue],
			    DATESBETWEEN(DateTable[Date], PreviousMonthStart, PreviousMonthEnd),
			    ALL(DateTable)
			)
		displayFolder: TIME INTELLIGENCE
		lineageTag: c18f85bb-8593-49be-a6e9-0fdad81f99c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Change MoM %' =
			
			DIVIDE(
			    [Revenue MTD] - [Total Revenue PM],
