		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marketing ROI' = ```
			
			VAR RevenueFromMarketing = 
			    SUMX(
			        FILTER(
			            LeadsPipeline,
			            LeadsPipeline[Status] = "Lease Signed" &&
			            LeadsPipeline[Source] IN {"Google Ads", "Facebook Ads", "Website Organic", "Property Portals", "Email Campaign"}
			        ),
			        LeadsPipeline[EstimatedMonthlyRent] * 12
			    )
			VAR MarketingSpend = [Total Marketing Spend]
			RETURN
			    DIVIDE(RevenueFromMarketing - MarketingSpend, MarketingSpend, 0)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: MARKETING METRICS
		lineageTag: 5972c35e-4386-4b34-acb5-fb8519c8e852

	measure 'Channel Conversion Rate' =
			
			DIVIDE(
			    SUM(MarketingCampaigns[Conversions]),
			    SUM(MarketingCampaigns[Leads]),
