	measure 'Lead to Customer Rate' =
			
			VAR Leads = [Total Marketing Leads]
			VAR Customers = [Total Marketing Conversions]
			RETURN
			    DIVIDE(Customers, Leads, 0)
		displayFolder: MARKETING METRICS
		lineageTag: 06393ca0-e1c6-4202-8e65-0f2fa0259411

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Campaign Performance Score' =
			
			AVERAGEX(
			    MarketingCampaigns,
			    (MarketingCampaigns[Conversions] / MarketingCampaigns[Leads]) * 100 +
			    (1 / MarketingCampaigns[CPL]) * 1000
