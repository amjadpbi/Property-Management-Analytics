	measure 'Expense Breakdown Value' = ```
			
			VAR Cat = SELECTEDVALUE('Expense Breakdown Table'[Category])
			RETURN
			SWITCH(
			    Cat,
			    "Revenue", [Total Revenue],
			    "Maintenance", -[Total Maintenance Cost],
			    "Utilities", -[Utilities Expenses],
			    "Staff", -[Staff Expenses],
			    "Marketing", -[Marketing Expense],
			    "Other", -[Other Expense],
			    "NOI", [NOI]
			)
			
			
			```
		displayFolder: FINANCIAL METRICS
		lineageTag: 9766294f-9854-469d-ab6c-e745051e544c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Marketing ROI by Channel' = ```
			
			VAR CurrentChannel = SELECTEDVALUE(MarketingCampaigns[Channel])
			VAR RevenueFromChannel = 
			    SUMX(
			        FILTER(
			            LeadsPipeline,
			            LeadsPipeline[Status] = "Lease Signed" &&
			            LeadsPipeline[Source] = CurrentChannel
			        ),
			        LeadsPipeline[EstimatedMonthlyRent] * 12
			    )
			VAR ChannelSpend = SUM(MarketingCampaigns[ActualSpend])
			RETURN
			    DIVIDE(RevenueFromChannel - ChannelSpend, ChannelSpend, 0)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: MARKETING METRICS
		lineageTag: e015a3c9-1f7c-4a75-a2fd-d386e2e9b387

	measure 'Lead Quality Score' =
			
			VAR ConvRate = [Lead Conversion Rate]
			VAR QualRate = [Qualification Rate]
			VAR AvgDays = [Avg Days to Convert]
			RETURN
			    (ConvRate * 0.5) + (QualRate * 0.3) + (1 - (AvgDays / 20) * 0.2)
		displayFolder: LEAD & SALES METRICS
		lineageTag: 71328eef-d9be-4623-bdcf-368e2af8fb95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lead Source ROI' = ```
			
			VAR SourceRevenue = 
			    SUMX(
			        FILTER(LeadsPipeline, LeadsPipeline[Status] = "Lease Signed"),
			        LeadsPipeline[EstimatedMonthlyRent] * 12
			    )
			VAR SourceSpend = 
			    CALCULATE(
			        SUM(MarketingCampaigns[ActualSpend]),
			        TREATAS(VALUES(LeadsPipeline[Source]), MarketingCampaigns[Channel])
			    )
			RETURN
			    DIVIDE((SourceRevenue - SourceSpend), SourceSpend, 0)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: MARKETING METRICS
		lineageTag: 116b74c1-44d5-4178-931e-a0c9cbbcab85

