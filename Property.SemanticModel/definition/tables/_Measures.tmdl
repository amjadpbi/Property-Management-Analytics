		displayFolder: REVENUE METRICS
		lineageTag: aa2a6ad9-ac55-4b15-bfa3-1d0b8548d300

	measure 'Potential Revenue' =
			
			SUM(FinancialData[PotentialRevenue])
		formatString: 0
		displayFolder: REVENUE METRICS
		lineageTag: e0dfd62b-787f-4df9-91bd-a24e93a30e5e

	measure 'Revenue Target' =
			
			SUM(FinancialData[RevenueTarget])
		displayFolder: REVENUE METRICS
		lineageTag: 4cdc723a-a6f0-4132-80a3-b8162b8c0f4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue vs Target' =
			
			[Total Revenue] - [Revenue Target]
		displayFolder: REVENUE METRICS
		lineageTag: 2f28c819-f89a-4f3d-85fe-1b5b498b682e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue vs Target %' =
			
			DIVIDE(
			    [Total Revenue] - [Revenue Target],
			    [Revenue Target],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: REVENUE METRICS
		lineageTag: 6aec8a40-b2da-4b81-9e41-99029bb29326

	measure 'Avg Monthly Revenue' =
			
			AVERAGEX(
			    VALUES(DateTable[YearMonth]),
			    [Total Revenue]
			)
		displayFolder: REVENUE METRICS
		lineageTag: b30e969c-9cdb-4763-81ec-f194c97abaa6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Portfolio Occupancy Rate' =
			
			DIVIDE(
			    SUM(DailyOccupancy[OccupiedUnits]),
			    SUM(DailyOccupancy[TotalUnits]),
			    0
			)
		formatString: 0%;-0%;0%
		displayFolder: OCCUPANCY METRICS
		lineageTag: c1a975eb-b803-44d4-944b-5ff225e72fdd

	measure 'Total Units' = SUM('Properties'[TotalUnits])
		formatString: 0
		displayFolder: REVENUE METRICS
		lineageTag: 8462ce53-4efb-4231-9d23-ab5a4d416050

	measure 'Revenue per Unit' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Units],
			    0
			)
		displayFolder: REVENUE METRICS
		lineageTag: 0cfa1489-13e5-4d5a-a162-8d8fcdf44067

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Occupancy Rate' =
			
			AVERAGEX(
			    DailyOccupancy,
			    DailyOccupancy[OccupancyRate]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: OCCUPANCY METRICS
		lineageTag: baef06ac-e204-4890-bbef-44a8c3223ea3

	measure 'Occupied Units' =
			
			SUM(DailyOccupancy[OccupiedUnits])
		formatString: 0
		displayFolder: OCCUPANCY METRICS
		lineageTag: 69c2d313-e02e-49b8-9440-836d85650520

	measure 'Vacant Units' =
			
			SUM(DailyOccupancy[VacantUnits])
		formatString: 0
		displayFolder: OCCUPANCY METRICS
		lineageTag: 08282d68-96f4-4f17-88d9-2633fdf4ec1a

	measure 'Properties Below 90%' =
			
			COUNTROWS(
			    FILTER(
			        SUMMARIZE(
			            DailyOccupancy,
			            DailyOccupancy[PropertyID],
			            "PropertyOccupancy", [Portfolio Occupancy Rate]
			        ),
			        [PropertyOccupancy] < 0.90
			    )
			)
		formatString: 0
		displayFolder: OCCUPANCY METRICS
		lineageTag: 211e2a0f-95f9-42c6-9fa8-b4ede7da362a

	measure 'Occupancy Trend' =
			
			VAR MinDate = MIN(DateTable[Date])
			VAR MaxDate = MAX(DateTable[Date])
			RETURN
			CONCATENATEX(
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(DateTable, DateTable[Date]),
			            "Occupancy", [Portfolio Occupancy Rate]
			        ),
			        DateTable[Date] >= MinDate && DateTable[Date] <= MaxDate
			    ),
			    FORMAT([Occupancy], "0.00%"),
			    ",",
			    DateTable[Date],
			    ASC
			)
		displayFolder: OCCUPANCY METRICS
		lineageTag: 9142e1ef-0041-4fa0-912e-5571a5529ff3

	measure 'Total Leads' =
			
			COUNTROWS(LeadsPipeline)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: f262cc52-b17b-438e-a62f-a127e6d3d4ac

	measure '1 - New Leads' =
			
			CALCULATE(
			    COUNTROWS(LeadsPipeline),
			    LeadsPipeline[Status] IN {"New", "Contacted", "Qualified", "Toured", "Application", "Lease Signed"}
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: 8d52f66a-55b2-4a55-858e-e08742584c92

	measure '3 - Qualified' =
			
			CALCULATE(
			    COUNTROWS(LeadsPipeline),
			    LeadsPipeline[Status] IN {"Qualified", "Toured", "Application", "Lease Signed"}
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: e1843f0c-8abf-48ef-9050-cf85d2e0bb83

	measure 'Converted Leads' =
			
			CALCULATE(
			    [Total Leads],
			    LeadsPipeline[Status] = "Lease Signed"
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: 38cf2921-b33c-4c76-8d9e-12197dfb31b2

	measure 'Lead Conversion Rate' =
			
			DIVIDE(
			    [Converted Leads],
			    [Total Leads],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: LEAD & SALES METRICS
		lineageTag: ccb69036-5f66-461e-a415-23f2b6993cbe

	measure 'Qualification Rate' =
			
			DIVIDE(
			    [3 - Qualified],
			    [Total Leads],
			    0
			)
		displayFolder: LEAD & SALES METRICS
		lineageTag: 389d43e7-8f0f-4368-b622-24dd3de8f819

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lead to Tour Conversion' =
			
			VAR TouredLeads = CALCULATE([Total Leads], LeadsPipeline[Status] IN {"Toured", "Application", "Lease Signed"})
			RETURN
			    DIVIDE(TouredLeads, [Total Leads], 0)
		displayFolder: LEAD & SALES METRICS
		lineageTag: 31d9af75-6179-4f47-b99d-e84b8d1ad9ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tour to Lease Conversion' =
			
			VAR TouredLeads = CALCULATE([Total Leads], LeadsPipeline[Status] IN {"Toured", "Application", "Lease Signed"})
			VAR ConvertedLeads = [Converted Leads]
			RETURN
			    DIVIDE(ConvertedLeads, TouredLeads, 0)
		displayFolder: LEAD & SALES METRICS
		lineageTag: eeea2f1a-16db-4e96-9816-aed1dd550e28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Days to Convert' =
			
			AVERAGEX(
			    FILTER(
			        LeadsPipeline,
			        NOT ISBLANK(LeadsPipeline[ConversionDate])
			    ),
			    DATEDIFF(
			        LeadsPipeline[LeadDate],
			        LeadsPipeline[ConversionDate],
			        DAY
			    )
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: 310d67bf-a610-4f7e-b704-4a1814a12079

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Lead Value' =
			
			SUMX(
			    FILTER(
			        LeadsPipeline,
			        LeadsPipeline[Status] = "Lease Signed"
			    ),
			    LeadsPipeline[EstimatedMonthlyRent] * 12
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: 9ab6f27f-e4d4-4a00-8152-d9b5da6ace8e

	measure 'Avg Lead Score' =
			
			AVERAGE(LeadsPipeline[LeadScore])
		displayFolder: LEAD & SALES METRICS
		lineageTag: 87431f18-7fff-4005-9770-479bb61cd7d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Pipeline Value' =
			
			SUMX(
			    LeadsPipeline,
			    LeadsPipeline[EstimatedMonthlyRent] * 12 *
			    SWITCH(
			        LeadsPipeline[Status],
			        "Qualified", 0.25,
			        "Toured", 0.50,
			        "Application", 0.75,
			        "Lease Signed", 1.00,
			        0
			    )
			)
		displayFolder: LEAD & SALES METRICS
		lineageTag: 17d71096-e938-4ac0-80e1-68d2bfd0d305

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pipeline Value' =
			
			SUMX(
			    FILTER(
			        LeadsPipeline,
			        LeadsPipeline[Status] IN {"Qualified", "Toured", "Application"}
			    ),
			    LeadsPipeline[EstimatedMonthlyRent] * 12
			)
		formatString: 0
		displayFolder: LEAD & SALES METRICS
		lineageTag: d42c3bbc-986f-4952-8400-79b97cc49fb2

	measure 'Total Expenses' =
			
			SUM(FinancialData[TotalExpenses])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: FINANCIAL METRICS
		lineageTag: da65b8a5-04e8-4503-999d-e7f1c5c96c88

	measure NOI =
			
			SUM(FinancialData[NetOperatingIncome])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: FINANCIAL METRICS
		lineageTag: c2dbbada-8544-4f53-bb45-db47a9bc4a73

	measure 'NOI Margin' =
			
			DIVIDE(
			    [NOI],
			    [Total Revenue],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: FINANCIAL METRICS
		lineageTag: cbb9f358-4440-446c-9d20-a2882b51d721

	measure 'Collection Rate' =
			
			DIVIDE(
			    SUM(FinancialData[CollectedRevenue]),
			    SUM(FinancialData[ActualRevenue]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: FINANCIAL METRICS
		lineageTag: ae25e902-77b5-4292-856b-83f9fe870aa6

	measure 'Delinquency Amount' =
			
			SUM(FinancialData[ActualRevenue]) - SUM(FinancialData[CollectedRevenue])
		displayFolder: FINANCIAL METRICS
		lineageTag: 5eb75652-8ab3-4eb9-b3b6-8a414dcc0125

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delinquency Rate' =
			
			1 - [Collection Rate]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: FINANCIAL METRICS
		lineageTag: 0a449527-d818-488c-ae5f-e0bfa5e5b55b

	measure 'Operating Expense Ratio' =
			
			DIVIDE(
			    [Total Expenses],
			    [Total Revenue],
			    0
			)
		displayFolder: FINANCIAL METRICS
		lineageTag: fd859782-ed3f-47f8-8647-2177836bc77c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Maintenance Cost per Unit' =
			
			DIVIDE(
			    SUM(FinancialData[MaintenanceCost]),
			    [Total Units],
			    0
			)
		displayFolder: FINANCIAL METRICS
		lineageTag: 8d14d052-4484-42ab-86b9-9a993954596f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue per Sq Ft' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Units] * 950, -- Assuming avg 950 sq ft per unit
			    0
			)
		displayFolder: FINANCIAL METRICS
		lineageTag: a04102da-fa72-4d27-b163-a6a5af13efe0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Break-even Occupancy' =
			
			DIVIDE(
			    [Total Expenses],
			    [Potential Revenue],
			    0
			)
		displayFolder: FINANCIAL METRICS
		lineageTag: 8542990d-cf86-4e72-86c4-7059ed270a7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Tickets' =
			
