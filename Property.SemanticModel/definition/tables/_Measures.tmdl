		formatString: 0
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 3099ac15-dda4-40a7-bf70-d43559d52f7b

	measure 'Calls Today' =
			
			CALCULATE(
			    [Total Calls],
			    AIReceptionistCalls[CallDate] = Max(AIReceptionistCalls[CallDate])
			)
		formatString: 0
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 6cfb4022-06f4-4195-82f1-cd9756ad7027

	measure 'Qualified Lead Calls' =
			
			CALCULATE(
			    [Total Calls],
			    AIReceptionistCalls[IsQualifiedLead] = TRUE
			)
		formatString: 0
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: f77d5fe5-8904-4837-b5aa-5b2c6c97e87e

	measure 'Lead Qualification Rate' =
			
			VAR NewLeadCalls = CALCULATE([Total Calls], AIReceptionistCalls[CallType] = "New Lead Inquiry")
			VAR QualifiedCalls = [Qualified Lead Calls]
			RETURN
			    DIVIDE(QualifiedCalls, NewLeadCalls, 0)
		formatString: 0%;-0%;0%
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 9fa3f4fc-d5c1-4dc9-b6f9-17fe8792c9ff

	measure 'Appointments Booked' =
			
			CALCULATE(
			    [Total Calls],
			    AIReceptionistCalls[AppointmentBooked] = TRUE
			)
		formatString: 0
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: c7dabaee-7ca5-4c21-97fc-afffe80bc339

	measure 'Appointment Booking Rate' = ```
			
			VAR EligibleCalls = 
			    CALCULATE(
			        [Total Calls],
			        AIReceptionistCalls[CallType] IN {"New Lead Inquiry", "Showing Request"}
			    )
			VAR BookedCalls = [Appointments Booked]
			RETURN
			    DIVIDE(BookedCalls, EligibleCalls, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 7b3dde05-c642-4cff-8a02-bb5ca51d1c1d

	measure 'Avg Call Duration' =
			
			AVERAGE(AIReceptionistCalls[DurationSeconds]) / 60
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: bab30bdd-660f-461b-b5e8-23c91a5181b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Call Minutes' =
			
			SUM(AIReceptionistCalls[DurationSeconds]) / 60
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 870eb00c-c285-4630-a0dd-49d768192fdb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Call Resolution Rate' =
			
			CALCULATE(
			    [Total Calls],
			    AIReceptionistCalls[Resolved] = TRUE
			) / [Total Calls]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 541650b7-387c-4c70-932a-7435b4d23e60

	measure 'Avg Sentiment Score' =
			
			AVERAGE(AIReceptionistCalls[SentimentScore])
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: ebbe31bb-ef05-46a1-b64c-e8349666b9dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Call Hour' = ```
			
			VAR CallsByHour = 
			    ADDCOLUMNS(
			        VALUES(AIReceptionistCalls[CallHour]),
			        "CallCount", [Total Calls]
			    )
			VAR MaxCalls = MAXX(CallsByHour, [CallCount])
			VAR PeakHour = 
			    MINX(
			        FILTER(CallsByHour, [CallCount] = MaxCalls),
			        AIReceptionistCalls[CallHour]
			    )
			RETURN PeakHour
			```
		formatString: 0
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 57c13767-1f2c-4e7a-a38d-52ac35b0054e

	measure 'AI Call to Lead Conversion' =
			
			VAR AILeadCalls = CALCULATE([Total Calls], AIReceptionistCalls[CallType] = "New Lead Inquiry")
			VAR AISourceLeads = CALCULATE([Total Leads], LeadsPipeline[Source] = "AI Receptionist")
			RETURN
			    DIVIDE(AISourceLeads, AILeadCalls, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: AI RECEPTIONIST METRICS
		lineageTag: 56975624-e042-419c-9341-e2d49e9cebd0

