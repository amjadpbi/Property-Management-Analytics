		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: f59e52df-f38f-4970-956d-ec8ee5400f96

	measure 'Open Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    MaintenanceTickets[Status] <> "Closed"
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 6b4d5b7b-bc84-4c31-81dc-ca812ff4ebe9

	measure 'Closed Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    MaintenanceTickets[Status] = "Closed"
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 33b0ef75-1525-481b-9fbe-c99673fb89f8

	measure 'Avg Resolution Time' =
			
			AVERAGEX(
			    FILTER(
			        MaintenanceTickets,
			        MaintenanceTickets[Status] = "Closed"
			    ),
			    MaintenanceTickets[DaysToResolve]
			)
		displayFolder: MAINTENANCE METRICS
		lineageTag: a159afc0-90f4-4338-a836-e6e03cce4154

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tickets This Month' =
			
			CALCULATE(
			    [Total Tickets],
			    DATESMTD(DateTable[Date])
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 3c642114-dd48-46a5-b2df-a2b8863980d1

	measure 'Emergency Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    MaintenanceTickets[Priority] = "Emergency"
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 1798a912-8fbe-49a8-8d3e-649c10a2164b

	measure 'Tickets by Priority' =
			
			CALCULATE(
			    [Total Tickets],
			    ALLEXCEPT(MaintenanceTickets, MaintenanceTickets[Priority])
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: f43676a3-07b4-4577-a771-c751ce733717

	measure 'Avg Ticket Cost' =
			
			AVERAGE(MaintenanceTickets[Cost])
		displayFolder: MAINTENANCE METRICS
		lineageTag: 05c28046-d967-4075-8b60-830f8ddf85d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Maintenance Cost' =
			
			SUM(MaintenanceTickets[Cost])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 9cf8e63f-3b73-4705-a58b-86a7d9c81726

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'SLA Compliance Rate' = ```
			
			VAR ClosedTickets = [Closed Tickets]
			VAR OnTimeTickets = 
			    CALCULATE(
			        [Total Tickets],
			        MaintenanceTickets[Status] = "Closed",
			        MaintenanceTickets[DaysToResolve] <= 
			            SWITCH(
			                MaintenanceTickets[Priority],
			                "Emergency", 1,
			                "High", 3,
			                "Medium", 7,
			                "Low", 14,
			                14
			            )
			    )
			RETURN
			    DIVIDE(OnTimeTickets, ClosedTickets, 0)
			```
		displayFolder: MAINTENANCE METRICS
		lineageTag: 2e6ded2c-7f09-4bc4-9cc1-f617fa715b8e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Aging Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    MaintenanceTickets[Status] <> "Closed",
			    MaintenanceTickets[DaysToResolve] > 7
			)
		formatString: 0
		displayFolder: MAINTENANCE METRICS
		lineageTag: 2844fe0e-a367-4511-b7d0-1b8cdb81ad24

	measure 'Work Order Completion Rate' =
			
			DIVIDE(
			    [Closed Tickets],
			    [Total Tickets],
			    0
			)
		displayFolder: MAINTENANCE METRICS
		lineageTag: cf9312a3-69c1-4fa2-bb04-4f702187a623

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Calls' =
			
