	measure 'MTD Leads' = CALCULATE([Total Leads], DATESMTD(LeadsPipeline[LeadDate]))
		formatString: 0
		displayFolder: TIME INTELLIGENCE
		lineageTag: 3a477f81-0051-49ec-b1a7-a2c5d355d57e

	measure 'Leads PM' = ```
			
			VAR CurrentMonth = MAX('LeadsPipeline'[LeadDate])
			VAR PrevMonthStart = DATE(YEAR(CurrentMonth), MONTH(CurrentMonth)-1, 1)
			VAR PrevMonthEnd = EOMONTH(CurrentMonth, -1)
			RETURN
			CALCULATE(
			    [Total Leads],
			    FILTER(
			        ALL('LeadsPipeline'[LeadDate]),  // Remove all date filters
			        'LeadsPipeline'[LeadDate] >= PrevMonthStart &&
			        'LeadsPipeline'[LeadDate] <= PrevMonthEnd
			    )
			)
			
			```
		formatString: 0
		displayFolder: TIME INTELLIGENCE
		lineageTag: c22d0a4c-c06a-4a4e-b636-5e71a6fd600b

	measure 'Lead Change MoM %' =
			
